generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Reservation {
  id         Int      @id @default(autoincrement())
  nom        String
  telephone  String
  service    String
  date       String
  heure      String
  message    String?  @db.Text
  statut     String   @default("en_attente")
  createdAt  DateTime @default(now())
}